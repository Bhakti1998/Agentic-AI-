    "def verifier_agent(state: AgentState):\n",
    "    print(\"--- VERIFYING THE DATA ---\")\n",
    "    \"\"\"VERIFIER AGENT TO CHECK IF RELEVANT INFORMATION IS AVAILABLE\"\"\"\n",
    "    \n",
    "    question = state['messages'][0].content\n",
    "    chunks= state['messages'][-1].content\n",
    "    \n",
    "    system_msg = SystemMessage (content= f\"\"\"\n",
    "    You are an intelligent comparison agent that compares user query and chunks extracted from the tools semantically and checks if the chunks are enough to answer a query.\n",
    "    Follow the below instructions:\n",
    "        1.Take user query : {question} and the chunks:{chunks}\n",
    "        2.Understand them semantically and verify if the chunks are enough to answer a user query\n",
    "        3.If the chunks are incomplete or not enough to answer the query reply strictly in following format:\n",
    "          1.'MAKE ANOTHER TOOL CALL'\n",
    "        4.If the chunks are complete and good enough to answer the query reply strictly in following format:\n",
    "          2.'GENERATE ANSWER'\n",
    "        5. Do not add extra text in your reply or hallucinate anything apart from details provided to you explicitly\n",
    "\n",
    "\n",
    "        Please answer the following query\n",
    "        Question:\n",
    "        {question}\n",
    "        by leveraging  the context provided below\n",
    "        Context:\n",
    "        {chunks}\"\"\")\n",
    "\n",
    "    try:\n",
    "        result = llm1.invoke([system_msg]+[question])\n",
    "        print(result.content)\n",
    "        return  {\n",
    "        \"messages\":[question]+[result]\n",
    "         }\n",
    "\n",
    "    except Exception as e:\n",
    "            err= f\"ERROR: {repr(e)}\"   \n",
    "            return {'messages':[question]+[err]}\n"
   ]
  },
